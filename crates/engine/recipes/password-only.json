{
  "id": "password-only",
  "name": "Password only (no username)",
  "timeout_ms": 30000,
  "steps": [
    { "action": "goto" },
    { "action": "wait",  "selector": "input[type=password]", "timeout_ms": 15000 },
    { "action": "fill",  "selector": "input[type=password]", "value": "{password}" },
    { "action": "click", "selector": "button[type=submit], input[type=submit]", "else_press_enter_in": "input[type=password]" }
  ],
  "success": { "any": [ { "selector_gone": "input[type=password]" } ] },
  "failure": { "any": [ { "selector": "[role=alert]" } ] }
}
